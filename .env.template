# Copy to .env and adjust values. Run `scripts/sync-version.sh` to sync APP_VERSION
# with package.json automatically.

# --- Application ---
APP_NAME=simple-url-shortener
APP_VERSION=0.0.1
APP_ENV=development

# --- Valkey ---
VALKEY_HOST=valkyr
VALKEY_PORT=6379

# --- API auth ---
# Bearer token required by all /api/* routes. Generate one with:
#   openssl rand -hex 32
API_TOKEN=change-me-to-a-long-random-secret

# Fallback redirect target for /sh/{code} when neither the variant nor the
# base code has a URL stored in Valkey.
DEFAULT_REDIRECT_URL=https://example.com

# Comma-separated list of domains redirects are allowed to target (subdomains
# of a listed domain are also allowed). Leave empty to allow any https URL.
# Example: ALLOWED_REDIRECT_DOMAINS=docs.company.com,tools.company.com
ALLOWED_REDIRECT_DOMAINS=

# --- Logging ---
# LOG_ENABLED: turn all application logging on/off
# LOG_LEVEL: minimum level emitted (DEBUG|INFO|WARNING|ERROR|CRITICAL)
# LOG_STYLE: output format (text|json)
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_STYLE=text

# --- Caddy ---
# CADDY_ENV selects infra/caddy/Caddyfile.<dev|prod>
#   dev  - serves a locally-trusted self-signed certificate (Caddy's internal CA)
#   prod - obtains a real certificate automatically via Let's Encrypt
CADDY_ENV=dev
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=8080
# Must match the port the selected Caddyfile listens on (dev: 8080, prod: 443)
CADDY_HTTPS_CONTAINER_PORT=8080

# Used by Caddyfile.prod only, for Let's Encrypt.
DOMAIN=example.com
ACME_EMAIL=admin@example.com
