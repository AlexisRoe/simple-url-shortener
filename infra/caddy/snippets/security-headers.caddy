(security_headers) {
	# Every request body this app expects is a small JSON object (a URL
	# string and an optional TTL/variant); reject anything grossly larger
	# before it reaches FastAPI. Kept in sync with
	# app.core.constants.MAX_REQUEST_BODY_BYTES, which enforces the same
	# limit inside the app itself for requests that bypass Caddy (e.g.
	# local development).
	request_body {
		max_size 16KB
	}

	# FastAPI's built-in Swagger UI (only ever mounted in development, see
	# docs_url in create_app()) pulls its JS/CSS bundle and favicon from
	# jsdelivr/fastapi's own CDN and boots itself via an inline <script>, so
	# it needs a relaxed CSP. The two header blocks below are matched so
	# they're mutually exclusive on path (Caddy defers header blocks that
	# use a header deletion, such as the "-Server" one below, until the end
	# of the request regardless of source order -- so a shared/unconditional
	# block would always win over a path-matched one if both could apply to
	# the same request).
	@docs path /docs /openapi.json
	header @docs {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'none'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' https://cdn.jsdelivr.net; img-src 'self' https://fastapi.tiangolo.com; connect-src 'self'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		-Server
	}

	@not_docs not path /docs /openapi.json
	header @not_docs {
		# Force HTTPS for future requests to this host, including subdomains.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Stop browsers from MIME-sniffing a response into a different
		# content type than the one declared in Content-Type.
		X-Content-Type-Options "nosniff"

		# This API is never meant to be framed by another site.
		X-Frame-Options "DENY"

		# No inline scripts/styles anywhere in this app, and nothing should
		# ever be framed in or out of it.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

		# Don't leak this origin's full URLs (including short codes) via the
		# Referer header when a resolved redirect leads to a third-party site.
		Referrer-Policy "no-referrer"

		# Remove the identifying server header Caddy sets by default.
		-Server
	}
}
